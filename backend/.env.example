# ── Database ──────────────────────────────────────────────────────
# MUST match setup.sh: CREATE USER boost WITH PASSWORD 'boost_password'
DATABASE_URL=postgresql+asyncpg://boost:boost_password@localhost:5432/boost_db

# ── Redis (DB 2 — separate from Nebula DB 0 and Aura DB 1) ────────
REDIS_URL=redis://localhost:6379/2

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=525600

# ── BytePlus (Volcano Engine) ─────────────────────────────────────
BYTEPLUS_API_KEY=your_byteplus_api_key_here
BYTEPLUS_BASE_URL=https://visual.volcengineapi.com
BYTEPLUS_REGION=ap-southeast-1

# Model IDs — verify these in BytePlus console
BYTEPLUS_VISION_MODEL=glm-4v
BYTEPLUS_REASONING_MODEL=deepseek-v3
BYTEPLUS_IMAGE_MODEL=high_aes_general_v20_L
BYTEPLUS_VIDEO_MODEL=bytedance-seedream-3-0-video

# ── App ───────────────────────────────────────────────────────────
APP_NAME=Boost
ENVIRONMENT=development
PORT=8004
INSTALL_DIR=/root/workspace/boost-app

# ── Google Play (for subscription verification) ────────────────────
GOOGLE_PLAY_PACKAGE=com.boost.app
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
